# ----------------------------------------------------------------------------
# Harness Agents — example environment
#
# Copy to apps/web/.env (Prisma reads this from the schema directory).
# Local-first MVP: secrets stay on this machine. Do NOT commit .env.
# ----------------------------------------------------------------------------

# Prisma / SQLite — path is relative to apps/web/prisma/schema.prisma.
# Resolves to apps/web/prisma/dev.db when migrations run.
DATABASE_URL="file:./dev.db"

# LLM provider API keys (optional — leave blank to disable that provider).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Ollama (OpenAI-compatible endpoint).
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Local secret-store fallback master key (32-byte base64).
# When keytar is unavailable, the AES-GCM SQLite fallback uses this key.
# For local MVP only — NOT a strong security boundary. See README.
HARNESS_SECRET_FALLBACK_KEY=""

# Workspace root for exported files (run.json, AGENTS.md, etc.).
# Defaults to <repo>/projects when unset.
HARNESS_WORKSPACE_ROOT=""
